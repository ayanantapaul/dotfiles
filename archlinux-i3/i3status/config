# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 1
}

# order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
# order += "battery all"
order += "disk /"
order += "load"
order += "cpu_usage"
order += "memory"
order += "volume master"
order += "tztime local"


wireless _first_ {
        # format_up = "W: (%quality at %essid) %ip"
        format_up = " W: %quality at %essid "
        format_down = " W: DOWN "
}

ethernet _first_ {
        # format_up = " E: %ip (%speed) "
        format_up = " E: %speed "
        format_down = " E: DOWN "
}

# battery all {
#         format = "%status %percentage %remaining"
# }

disk "/" {
        format = " DISK (/): %used / %total "
}

load {
	# Customize the placeholders (%1min, %5min, %15min)
	format = " LOAD: %1min %5min "
	# If the 1-minute load average exceeds 4.0, color the text red
	max_threshold = "4.0"
}

cpu_usage {
	format = " CPU: %usage "
	max_threshold = 85
	degraded_threshold = 70
}

memory {
        format = " MEMORY: %used / %total "
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %total"
}

tztime local {
        format = " DATE: %d.%m.%Y "
}

volume master {
    format = " VOL: %volume "
    format_muted = "VOL: muted (%volume)"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}
